<%= render 'pdfs/document_header',
      title: 'INVOICE',
      document: @invoice,
      client: @client,
      contact: @contact,
      business: @business,
      to_label: 'Bill To',
      logo_data_uri: @logo_data_uri,
      subtitle: @invoice.start_date ? "Period: #{@invoice.start_date.strftime('%d %b %Y')} – #{@invoice.end_date.strftime('%d %b %Y')}" : nil %>

<%= render "pdfs/line_items_table", items: @items, document_type: :invoice, project: nil %>

<% # A text-only custom line has amount: nil (nothing to bill) — guard against it here same as
   # Invoice#recalculate_total! does, since a plain `nil + number` would raise.
   subtotal   = @items.sum { |i| i.amount || 0 }
   tax_amount = @items.sum { |i| (i.amount || 0) * i.tax_rate / 100 }
   tax_rate   = @items.map(&:tax_rate).find { |r| r > 0 } %>
<div class="total-section">
  <div style="min-width:320px;">
    <% if tax_amount > 0 %>
      <div style="display:flex; justify-content:space-between; margin-bottom:5px;">
        <span class="total-label">Subtotal</span>
        <span style="font-size:12px; color:#374151;">$<%= "%.2f" % subtotal %></span>
      </div>
      <div style="display:flex; justify-content:space-between; margin-bottom:5px;">
        <span class="total-label">HST (<%= "%.4g" % tax_rate %>%)<% if @business.hst_number.present? %> &middot; Reg# <%= @business.hst_number %><% end %></span>
        <span style="font-size:12px; color:#374151;">$<%= "%.2f" % tax_amount %></span>
      </div>
    <% end %>
    <div style="display:flex; justify-content:space-between; align-items:baseline; padding-top:6px; border-top:1px solid #e5e7eb;">
      <span class="total-label">Total</span>
      <span class="total-amount">$<%= "%.2f" % @invoice.total %></span>
    </div>
      <% if @invoice.status == "paid" %>
        <div style="display:flex; justify-content:space-between; margin-top:6px; padding-top:6px; border-top:1px solid #e5e7eb;">
          <span class="total-label">Amount Paid</span>
          <span style="font-size:12px; color:#374151;">$<%= "%.2f" % @invoice.amount_paid %></span>
        </div>
        <div style="display:flex; justify-content:space-between; margin-top:4px;">
          <span class="total-label">Payment Date</span>
          <span style="font-size:12px; color:#374151;"><%= @invoice.paid_at.in_time_zone.strftime("%d %b %Y") %></span>
        </div>
      <% end %>
  </div>

</div>

<div class="footer">
  <% terms = @client.sales_terms.presence || @business.default_payment_terms.presence || "NET 15" %>
  Payment terms: <strong><%= terms %></strong><br/>
  <%= @business.invoice_footer.presence || "Thank you for your business." %>
</div>

<% if @invoice.status == "paid" %>
  <div style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) rotate(-35deg);
              font-size:96px; font-weight:900; color:rgba(34,197,94,0.25);
              letter-spacing:0.1em; pointer-events:none; z-index:100;">
    PAID
  </div>
<% end %>
